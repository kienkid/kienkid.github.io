{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XAU/USD daily close",
  "type": "object",
  "required": [
    "meta",
    "data"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schemaVersion",
        "sample",
        "dataset",
        "unit"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "sample": {
          "type": "boolean",
          "description": "true = bundled demo data; ignored and replaced by the first workflow run"
        },
        "timezone": {
          "type": "string",
          "const": "Asia/Ho_Chi_Minh"
        },
        "dataset": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "close"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Calendar day, Hanoi time (YYYY-MM-DD)"
          },
          "close": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "USD per troy ounce"
          },
          "src": {
            "type": "string",
            "enum": [
              "stooq",
              "yahoo:GC=F"
            ]
          }
        }
      }
    }
  },
  "$id": "./xau-usd.schema.json"
}