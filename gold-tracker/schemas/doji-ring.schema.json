{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOJI Ring 9999 daily prices",
  "type": "object",
  "required": [
    "meta",
    "data"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schemaVersion",
        "sample",
        "dataset",
        "unit",
        "product"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "sample": {
          "type": "boolean",
          "description": "true = bundled demo data; ignored and replaced by the first workflow run"
        },
        "timezone": {
          "type": "string",
          "const": "Asia/Ho_Chi_Minh"
        },
        "dataset": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "product": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "sell"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Calendar day, Hanoi time (YYYY-MM-DD)"
          },
          "sell": {
            "type": "number",
            "minimum": 30000000,
            "description": "Sell price, VND per tael (charted series)"
          },
          "buy": {
            "type": [
              "number",
              "null"
            ],
            "description": "Buy price, VND per tael"
          },
          "sourceUnit": {
            "type": "string",
            "description": "Unit caption on the DOJI board, e.g. 'NGHIN VND/CHI' (×1000×10 applied), or 'backfill VND/tael'"
          },
          "capturedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-8601 timestamp with +07:00 offset"
          },
          "src": {
            "type": "string"
          }
        }
      }
    }
  },
  "$id": "./doji-ring.schema.json"
}