{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOJI Nhẫn tròn 9999 (Hưng Thịnh Vượng) – daily close from giavang24k",
  "type": "object",
  "required": [
    "meta",
    "data"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schemaVersion",
        "sample",
        "dataset",
        "unit",
        "startDate",
        "frozen",
        "product"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 2
        },
        "sample": {
          "type": "boolean",
          "description": "true = bundled demo data; ignored and replaced by the seed run"
        },
        "timezone": {
          "type": "string",
          "const": "Asia/Ho_Chi_Minh"
        },
        "startDate": {
          "type": "string",
          "const": "2026-06-11",
          "description": "First day of the frozen history"
        },
        "frozen": {
          "type": "boolean",
          "description": "true = existing days are never overwritten (append-only); false for the derived file"
        },
        "dataset": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "product": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "sell"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Calendar day, Hanoi time (YYYY-MM-DD), >= 2026-06-11"
          },
          "sell": {
            "type": "number",
            "minimum": 30000000,
            "description": "Sell close, VND per lượng (charted series) = points[].sell.close"
          },
          "buy": {
            "type": [
              "number",
              "null"
            ],
            "description": "Buy close, VND per lượng = points[].buy.close"
          },
          "spreadAvg": {
            "type": [
              "number",
              "null"
            ],
            "description": "Average buy/sell spread of the day as published"
          },
          "capturedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-8601 timestamp with +07:00 offset"
          },
          "src": {
            "type": "string",
            "const": "giavang24k"
          }
        }
      }
    }
  },
  "$id": "./doji-ring.schema.json"
}