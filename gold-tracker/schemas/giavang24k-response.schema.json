{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "giavang24k /api/history/doji-nhan response (input format for the seed file)",
  "type": "object",
  "required": [
    "points"
  ],
  "properties": {
    "productKey": {
      "type": "string"
    },
    "range": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "day",
          "sell"
        ],
        "properties": {
          "day": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Calendar day, Hanoi time (YYYY-MM-DD), >= 2026-06-11"
          },
          "buy": {
            "$ref": "#/$defs/ohlc"
          },
          "sell": {
            "$ref": "#/$defs/ohlc"
          },
          "spreadAvg": {
            "type": "number"
          }
        }
      }
    }
  },
  "$defs": {
    "ohlc": {
      "type": "object",
      "required": [
        "close"
      ],
      "properties": {
        "open": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "close": {
          "type": "number"
        }
      }
    }
  },
  "$id": "./giavang24k-response.schema.json"
}