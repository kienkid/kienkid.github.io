{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run metadata",
  "type": "object",
  "required": [
    "schemaVersion",
    "sample",
    "lastUpdated",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "sample": {
      "type": "boolean"
    },
    "lastUpdated": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO-8601 timestamp with +07:00 offset"
    },
    "lastMode": {
      "type": "string",
      "enum": [
        "seed",
        "append"
      ]
    },
    "timezone": {
      "type": "string"
    },
    "startDate": {
      "type": "string"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "partial",
              "error"
            ]
          },
          "lastSuccess": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-8601 timestamp with +07:00 offset"
          },
          "message": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    }
  },
  "$id": "./meta.schema.json"
}